#!/usr/bin/env nu

let COUNTER_FILE = $"($env.HOME)/.cache/wbg_counter.txt"
let WALLPAPER_DIR = $"($env.HOME)/.backgrounds/wallpapers/"
let TOTAL_WALLPAPERS = (ls $WALLPAPER_DIR | length)
let SERVICE_NAME = "wbg.service"
let SERVICE_DESCRIPTION = "Wallpaper daemon"


def kill_wbg [] {
    let wbg_service_is_running = (systemctl --user is-active --quiet wbg.service | complete | get exit_code)
    if ($wbg_service_is_running == 0) {
        systemctl --user stop $SERVICE_NAME
    }
    let wbg_process_is_running = (ps | where name =~ 'wbg' | is-empty)
    if not $wbg_process_is_running {
        killall -q wbg
    }
}

def get_current_count [] {
    mut current_count: int = if ($COUNTER_FILE | path exists) {
        let tmp = open $COUNTER_FILE | lines | first | into int
        if ($tmp <= 0 or $tmp > $TOTAL_WALLPAPERS) {
            1
        } else {
            $tmp | into int
        }
    } else {
        "1" | save $COUNTER_FILE
        1
    }
    return $current_count
}

def main [action?: string, wallpaper_path?: string] {
    match $action {
        "next" => { next_wallpaper }
        "previous" | "prev" => { previous_wallpaper }
        "set" => {
            if ($wallpaper_path | is-empty) {
                print "Usage: wbg set <wallpaper_path>"
                return
            }
            set_wallpaper $wallpaper_path (get_current_count)
        }
        _ => {
            print "Usage: wbg [next|previous|set <path>]"
        }
    }
}

def set_wallpaper [wallpaper_path: string, current_count: int] {
    if not ($wallpaper_path | path exists) {
        notify-send $"Wallpaper not found ($wallpaper_path)"
        return
    }
    kill_wbg

    systemd-run --user --unit $SERVICE_NAME --description $SERVICE_DESCRIPTION wbg $wallpaper_path
}


def next_wallpaper [] {
    let current_count = get_current_count
    let next_count = (($current_count mod $TOTAL_WALLPAPERS) + 1)
    let selected_wallpaper = ls $WALLPAPER_DIR | sort -n | get ($next_count - 1) | get name
    set_wallpaper $selected_wallpaper $next_count

    $next_count | save -f $COUNTER_FILE
}

def previous_wallpaper [] {
    let current_count = get_current_count
    let previous_count = if ($current_count == 1) { $TOTAL_WALLPAPERS } else { $current_count - 1 }
    let selected_wallpaper = ls $WALLPAPER_DIR | sort -n | get ($previous_count - 1) | get name
    set_wallpaper $selected_wallpaper $previous_count

    $previous_count | save -f $COUNTER_FILE
}