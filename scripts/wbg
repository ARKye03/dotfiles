#!/usr/bin/env nu

let COUNTER_FILE = $"($env.HOME)/.cache/wbg_counter.txt"
let WALLPAPER_DIR = $"($env.HOME)/.backgrounds/wallpapers/"
let TOTAL_WALLPAPERS = (ls $WALLPAPER_DIR | length)
let SERVICE_NAME = "wbg.service"
let SERVICE_DESCRIPTION = "Wallpaper daemon"
let WALLPAPERS_TABLE = (ls $WALLPAPER_DIR | sort -n)


def kill_wbg [] {
    let wbg_service_is_running = (systemctl --user is-active --quiet $SERVICE_NAME | complete | get exit_code)
    if ($wbg_service_is_running == 0) {
        systemctl --user stop $SERVICE_NAME
    }
    let wbg_process_is_running = (ps | where name =~ 'wbg' | is-empty)
    if not $wbg_process_is_running {
        killall -q wbg
    }
}

def get_current_count [] {
    mut current_count: int = if ($COUNTER_FILE | path exists) {
        let tmp = open $COUNTER_FILE | lines | first | into int
        if ($tmp <= 0 or $tmp > $TOTAL_WALLPAPERS) {
            1
        } else {
            $tmp | into int
        }
    } else {
        "1" | save $COUNTER_FILE
        1
    }
    return $current_count
}

def set_wallpaper [wallpaper_path: string] {
    if not ($wallpaper_path | path exists) {
        notify-send $"Wallpaper not found ($wallpaper_path)"
        return
    }
    kill_wbg

    systemd-run --user --unit $SERVICE_NAME --description $SERVICE_DESCRIPTION wbg $wallpaper_path
}

def set_count [count: int] {
    $count | save -f $COUNTER_FILE
}

def main [] {
    print $"Usage: wbg [next|previous|fixed <number>]"
}

def "main next" [] {
    let current_count = get_current_count
    let next_count = (($current_count mod $TOTAL_WALLPAPERS) + 1)
    let selected_wallpaper = $WALLPAPERS_TABLE | get ($next_count - 1) | get name
    set_wallpaper $selected_wallpaper
    set_count $next_count
}

def "main previous" [] {
    let current_count = get_current_count
    let previous_count = if ($current_count == 1) { $TOTAL_WALLPAPERS } else { $current_count - 1 }
    let selected_wallpaper = $WALLPAPERS_TABLE | get ($previous_count - 1) | get name
    set_wallpaper $selected_wallpaper
    set_count $previous_count
}

def "main fixed" [fixed_count: int] {
    if ($fixed_count <= 0 or $fixed_count > $TOTAL_WALLPAPERS) {
        print $"Invalid wallpaper number. It should be between 1 and ($TOTAL_WALLPAPERS)"
        return
    }

    let selected_wallpaper = $WALLPAPERS_TABLE | get ($fixed_count - 1) | get name
    set_wallpaper $selected_wallpaper
    set_count $fixed_count
}
